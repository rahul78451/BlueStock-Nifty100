# ============================================================
# BlueStock Nifty 100 — Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================

# Django
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For local development (SQLite) — leave as is:
DATABASE_URL=sqlite:///db.sqlite3

# For production (PostgreSQL) — replace with your credentials:
# DATABASE_URL=postgresql://bluestock:yourpassword@localhost:5432/bluestock_dw
# DB_USER=bluestock
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# Redis (required for Celery)
REDIS_URL=redis://localhost:6379/0
